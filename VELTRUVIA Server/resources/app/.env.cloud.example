# ═════════════════════════════════════════════安装═══════════════════════════════
# VELTRUVIA — Cloud deployment environment (copy to .env in this folder)
#   cp .env.cloud.example .env   # then fill in the two secrets
# ═══════════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
PHI_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ── HTTPS (production profile) ────────────────────────────────────
# Domain with a DNS A record pointing at this VM. Caddy issues the
# Let's Encrypt certificate automatically — no cert files needed.
VELTRUVIA_DOMAIN=emr.example.com
ACME_EMAIL=you@example.com

# ── Optional ──────────────────────────────────────────────────────
# Where the API port binds when running WITHOUT the Caddy profile
VELTRUVIA_BIND=127.0.0.1
# Lab-instrument TCP listener (leave false unless you use MLLP)
MLLP_ENABLED=false
# Extra browser origins allowed cross-origin (comma-separated)
CORS_ORIGINS=
